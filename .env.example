# ==============================================================================
# Environment Variables for mj-portfolio
# Copy this file to .env.local and fill in the values
# ==============================================================================

# Database
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mj-portfolio?retryWrites=true&w=majority"

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET="generate-a-secure-32-byte-secret-with-openssl-rand-hex-32"
ADMIN_EMAIL="manthan@example.com"
AUTH_GITHUB_ID="github-oauth-client-id"
AUTH_GITHUB_SECRET="github-oauth-client-secret"

# Cloudinary (Media / Image uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Resend (Contact email notifications)
RESEND_API_KEY="re_123456789_abcdef"
CONTACT_TO_EMAIL="manthan@example.com"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

